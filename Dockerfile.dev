FROM node:20-alpine

# Install FFmpeg, yt-dlp, and system dependencies (including vips for sharp)
RUN apk add --no-cache ffmpeg ffmpeg-libs yt-dlp git vips

# Install pnpm
RUN corepack enable && corepack prepare pnpm@latest --activate

WORKDIR /app

# Copy package files
COPY package.json pnpm-lock.yaml* ./

# Install all dependencies (including dev)
RUN pnpm install --frozen-lockfile

# Copy the rest of the application
COPY . .

# Create tmp directories for file uploads and FFmpeg working
RUN mkdir -p /app/tmp/uploads /app/tmp/processed /app/tmp/ffmpeg

# Set environment
ENV NODE_ENV=development
ENV NEXT_TELEMETRY_DISABLED=1

EXPOSE 3000

# Start development server with hot-reload
CMD ["pnpm", "dev"]
